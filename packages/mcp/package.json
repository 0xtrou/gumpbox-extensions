{
  "name": "@gumpbox/mcp",
  "version": "0.1.0",
  "description": "Gumpbox MCP client — stdio proxy + HTTP MCP client + bundled skills. Bridges AI editors to the gumpbox app.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gumpbox-mcp-proxy": "./bin/mcp-proxy.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo no-op",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.16.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
